{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_OUTPUT_STANDALONE"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.preset.ts"]
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.preset.ts",
        "$TURBO_ROOT$/.env.test",
        "$TURBO_ROOT$/.env.example"
      ]
    },
    "//#typecheck:repo": {},
    "//#test:repo": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/config/src/schema.ts"
      ]
    },
    "test:int": {
      "dependsOn": ["^test:int"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.preset.ts"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["APP_VERSION", "GIT_COMMIT"]
    }
  }
}
