{
  "name": "shorts-factory",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "tasks": "node scripts/tasks.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "db:generate": "pnpm --filter @sf/db db:generate",
    "db:migrate": "pnpm --filter @sf/db db:migrate",
    "db:seed": "pnpm --filter @sf/db db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  }
}
