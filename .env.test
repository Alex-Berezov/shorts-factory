# Test environment: local Compose addresses only, no secrets. Committed on purpose.
# Loaded by packages/config/vitest/setup.ts before any test imports @sf/config.
# NODE_ENV is load-bearing: overrideEnvFile() purges every EnvSchema key from
# process.env before applying this fixture, so this line is what restores it -
# without it EnvSchema falls back to its fail-safe "production" default and the
# production rule (ADMIN_PASSWORD >= 16 characters) rejects this fixture.
NODE_ENV=test
DATABASE_URL=postgresql://sf:sf@localhost:5442/shorts_factory_test
REDIS_URL=redis://localhost:6389/1
MEDIA_DIR=./data/media-test
ADMIN_PASSWORD=testtest
