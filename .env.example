# Read by @sf/config with Node's `util.parseEnv`, under `pnpm dev` and in the
# containers of the full stack alike (they get this file mounted read-only), so
# a value means the same on both paths. Quotes are allowed and stripped
# (`KEY="a#b"` is `a#b`); an unquoted value ends at the first `#`
# (`KEY=a#b` is `a`) - quote a value that contains one.
# A `$` in a value: single quotes (`KEY='a$b'`), or Compose reports the name after the `$` (infra/README.md).

# --- Core ---
# NODE_ENV is left unset on purpose: an undeclared environment is validated as
# production, where ADMIN_PASSWORD must be at least 16 characters. Uncomment
# the line below for local work.
# NODE_ENV=development
# Host ports of infra/docker-compose.yml are shifted off the defaults (5442,
# 6389) so the stack can run next to another project's Postgres and Redis.
# An .env made before this change still says 5432/6379: fix both lines there,
# or db:migrate will talk to whatever else owns those ports.
DATABASE_URL=postgres://sf:sf@localhost:5442/shorts_factory
REDIS_URL=redis://localhost:6389
MEDIA_DIR=./data/media
# basic auth for the admin UI - empty like every other secret here: a working
# password in a public template is a working password on the first machine that
# copies it. At least 16 characters unless NODE_ENV says development or test.
ADMIN_PASSWORD=
# 32-byte hex for AES-256-GCM (google refresh token at rest)
TOKEN_ENCRYPTION_KEY=

# Build fingerprint reported by /system/status. Literal values only: nothing
# in `.env` is a shell command, so `$(git rev-parse ...)` belongs on the command
# line, not here. Compose passes both from the shell or from the root `.env`
# to the api image as build args; with `docker compose --env-file .env.example`
# it does not read `.env` and only the shell reaches the build. A value set
# there is baked into the image by `docker compose up --build` (or `build`).
# An image built without a value carries them empty, and the api container then
# takes the value from the mounted `.env` when it is started again, no rebuild.
# That holds while the file the container sees is the one you edited: not
# verified on Linux, where an editor that replaces the file (`sed -i`) may leave
# the container the old one until `docker compose down && up`. An image built
# with a non-empty value keeps it: editing `.env` changes nothing until the next
# `--build`. A value that is not a valid label (spaces, a slash, over 64 characters) is
# read as unset: if it was baked in, `.env` does not override it and
# /system/status answers null. A local run (`pnpm dev`) reads the file directly;
# an empty line changes nothing, and unset answers null.
# APP_VERSION=
# GIT_COMMIT=

# --- Services ---
# API_PORT, API_INTERNAL_URL and GOOGLE_OAUTH_REDIRECT_URL carry the same api
# port: change them together, nothing cross-checks them.
API_PORT=3001
WEB_PORT=3000
API_INTERNAL_URL=http://localhost:3001
LOG_LEVEL=info
# jobs per queue, not per process: one Worker runs per queue, so the process
# holds up to this many jobs times the number of queues
WORKER_CONCURRENCY=5

# --- Google / YouTube ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3001/oauth/google/callback
# for public Data API reads
YOUTUBE_API_KEY=
# At most 10000 - the daily quota of the Data API itself; a larger value is
# refused at start (env validation), no service comes up.
YT_UNITS_DAILY_SOFT_CAP=8000

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_DAILY_BUDGET_USD=5

# --- TTS (Phase 4, leave empty until needed) ---
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
TTS_MONTHLY_BUDGET_USD=50
